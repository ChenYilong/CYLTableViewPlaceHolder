# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.1'
ENV['SWIFT_VERSION'] = '5'
project 'CYLExample.xcodeproj'

prepare_react_native_project!

# [EN] The native container is Objective-C over the Swift CYLRefresh of the CYLTableViewPlaceHolder pod, which CocoaPods hands over as a module
#      only for frameworks: static frameworks, as CYLTabBarController's React Native example.
# [CN] 原生容器是 Objective-C，调用 CYLTableViewPlaceHolder pod 中 Swift 的 CYLRefresh；CocoaPods 只为 framework 提供模块：
#      使用静态 framework，与 CYLTabBarController 的 React Native 示例相同。
use_frameworks! :linkage => :static

target 'CYLExample' do
  config = use_native_modules!

  # CYLTableViewPlaceHolder from this repository (the core: CYLRefresh and the placeholder views).
  pod 'CYLTableViewPlaceHolder', :path => '../../../..'
  # The rive refresh style (headerStyle / footerStyle 'rive') draws with RiveRuntime; without this subspec it is the classic style with one log line.
  pod 'CYLTableViewPlaceHolder/Rive', :path => '../../../..'
  # CYLAnimatedItem, which the core depends on: CYLTabBarController at the commit the Cartfile pins. CYL_TAB_BAR_CONTROLLER_DIR is a
  # local checkout at that commit (no network); without it CocoaPods clones GitHub.
  # CYLAnimatedItem 是核心的依赖：CYLTabBarController 的 Cartfile 固定提交。CYL_TAB_BAR_CONTROLLER_DIR 为该提交的本地检出（无需联网）。
  tab_bar_commit = File.read(File.join(__dir__, '../../../../Cartfile'))[/^github "ChenYilong\/CYLTabBarController" "([0-9a-f]{40})"/, 1]
  # The commit splits CYLBadge and CYLUtils out of the tab bar repository (CYLAnimatedItem/Core depends on them; CYLUtils needs
  # CYLDeallocBlockExecutor ~> 1.4, which is not on the CocoaPods trunk): all are taken from the same place.
  if ENV['CYL_TAB_BAR_CONTROLLER_DIR']
    %w[CYLAnimatedItem CYLBadge CYLUtils].each { |name| pod name, :path => ENV['CYL_TAB_BAR_CONTROLLER_DIR'] }
  else
    %w[CYLAnimatedItem CYLBadge CYLUtils].each do |name|
      pod name, :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => tab_bar_commit
    end
  end
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '4276a6dab5a428ccc3a5f3f347eab991881fb97c'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    # [EN] fmt 11.0.2 (React Native 0.76's) does not compile with Xcode 27's clang (call to consteval function ... is not a constant
    #      expression); fmt's header has no switch to set from outside, so its consteval is turned off in the generated Pods folder.
    # [CN] React Native 0.76 的 fmt 11.0.2 无法用 Xcode 27 的 clang 编译（call to consteval function ... is not a constant expression）；
    #      fmt 头文件没有可从外部设置的开关，所以在生成的 Pods 目录里关闭其 consteval。
    fmt_base = File.join(installer.sandbox.root, 'fmt/include/fmt/base.h')
    File.chmod(0644, fmt_base) if File.exist?(fmt_base)
    File.write(fmt_base, File.read(fmt_base).gsub(/(#\s*define FMT_USE_CONSTEVAL) 1/, '\\1 0')) if File.exist?(fmt_base)
    # [EN] Every pod at React Native's minimum deployment target (15.1): `docs/instructions/macos.md` asks for 15.0, which React Native 0.76 does not support.
    # [CN] 所有 pod 使用 React Native 的最低部署版本（15.1）：`docs/instructions/macos.md` 要求 15.0，React Native 0.76 不支持。
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.1"
      end
    end
  end
end
