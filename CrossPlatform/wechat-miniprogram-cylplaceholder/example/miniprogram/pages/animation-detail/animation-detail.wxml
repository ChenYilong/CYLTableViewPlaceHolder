<!-- CYLAnimationDetailViewController: the right bar item "Replay", then the animation and its title, centered. -->
<view class="page">
  <view class="bar">
    <view class="bar__button" hover-class="bar__button--pressed" bindtap="replay">{{replayTitle}}</view>
  </view>
  <view class="stage">
    <view class="animation">
      <cyl-lottie wx:if="{{engine === 'json' && path}}" id="animation" path="{{path}}" loop="{{false}}"
        autoplay="{{true}}" />
      <image wx:elif="{{engine === 'gif' && path && showGif}}" class="gif" src="{{path}}" mode="aspectFit" />
      <view wx:elif="{{note}}" class="note">{{note}}</view>
    </view>
    <text class="title">{{title}}</text>
  </view>
</view>
