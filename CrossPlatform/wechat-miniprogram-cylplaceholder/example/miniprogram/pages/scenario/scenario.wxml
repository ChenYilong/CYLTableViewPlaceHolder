<view class="controls">
  <view class="control"><text>Interactive</text><switch checked="{{interactive}}" bindchange="onInteractiveChange" /></view>
  <view class="control"><text>Load data on retry</text><switch checked="{{loadOnRetry}}" bindchange="onLoadOnRetryChange" /></view>
  <view wx:if="{{lastAction}}" class="last-action">Last action: {{lastAction}}</view>
</view>
<!-- Animation playback controls (docs/Example-Animation-Playback.md): Play all from 0, speed, loop; applied live. -->
<view wx:if="{{hasAnimation}}" class="controls">
  <view class="control"><text>Animated (Lottie)</text><switch checked="{{animated}}" bindchange="onAnimatedChange" /></view>
  <block wx:if="{{animated}}">
    <view class="control">
      <text>Speed {{speedText}}×</text>
      <slider class="slider" min="25" max="300" step="25" value="{{speed * 100}}" block-size="20" bindchanging="onSpeedChange" bindchange="onSpeedChange" />
    </view>
    <view class="control"><text>Loop</text><switch checked="{{loop}}" bindchange="onLoopChange" /></view>
    <view class="play-all" hover-class="play-all--pressed" bindtap="onPlayAll">Play all</view>
  </block>
</view>
<view class="list">
  <block wx:if="{{rows.length}}">
    <view wx:for="{{rows}}" wx:key="*this" class="list__row">{{item}}</view>
    <view class="list__clear" bindtap="onClear">Clear rows</view>
  </block>
  <cyl-placeholder id="loading" wx:elif="{{loading}}" scenario="Loading" language="{{language}}" interactive="{{false}}"
                   generic:animation="cyl-lottie" animated="{{animated}}" />
  <cyl-placeholder id="placeholder" wx:else scenario="{{scenario}}" language="{{language}}" interactive="{{interactive}}"
                   generic:animation="cyl-lottie" animated="{{animated}}" loop="{{loop}}" speed="{{speed}}"
                   bind:action="onPlaceholderAction" />
</view>
