<!-- CYLRefreshNormalHeader: an arrow (a spinner while refreshing) and the state text; put it in the scroll-view
     with refresher-default-style="none". data: header -->
<template name="cyl-refresh-header">
  <view slot="refresher" class="cyl-refresh">
    <image wx:if="{{header.state === 'refreshing'}}" class="cyl-refresh__spinner"
           src="/components/cyl-placeholder/images/refresh_activity.gif" mode="aspectFit" />
    <text wx:else class="cyl-refresh__arrow {{header.state === 'pulling' ? 'cyl-refresh__arrow--up' : ''}}">↓</text>
    <text class="cyl-refresh__text">{{header.text}}</text>
  </view>
</template>

<!-- An auto footer: the state text, with an icon while loading. data: footer, gif (true: the 28x28
     CYLRefreshActivity.gif of CYLRefreshAutoAnimationFooter; false: the spinner of CYLRefreshAutoNormalFooter) -->
<template name="cyl-refresh-footer">
  <view class="cyl-refresh cyl-refresh--footer" bindtap="onFooterTap">
    <image wx:if="{{footer.state === 'refreshing'}}" class="{{gif ? 'cyl-refresh__gif' : 'cyl-refresh__spinner'}}"
           src="/components/cyl-placeholder/images/refresh_activity.gif" mode="aspectFit" />
    <text class="cyl-refresh__text">{{footer.text}}</text>
  </view>
</template>
