<!-- CYLScenarioDetailViewController: right bar items read "Tap: on | Clear"; an empty plain table shows the placeholder. -->
<view class="page">
  <view class="bar">
    <view class="bar__button" hover-class="bar__button--pressed" bindtap="onToggleInteraction" aria-role="button">{{interactionTitle}}</view>
    <view class="bar__button" hover-class="bar__button--pressed" bindtap="onClear" aria-role="button">{{clearTitle}}</view>
  </view>
  <view wx:if="{{rows.length}}" class="plain">
    <view wx:for="{{rows}}" wx:key="*this" class="cell cell--icon">
      <view class="cell__icon">📄</view>
      <text class="cell__title cell__text">{{item}}</text>
    </view>
  </view>
  <view wx:else class="placeholder">
    <cyl-placeholder wx:if="{{isLoading}}" scenario="Loading" language="{{language}}"
                     generic:animation="cyl-lottie" animated="{{true}}" />
    <cyl-placeholder wx:else id="placeholder" scenario="{{scenario}}" components="{{components}}" interactive="{{interactionEnabled}}"
                     language="{{language}}" generic:animation="cyl-lottie" animated="{{true}}" loop="{{loop}}"
                     speed="{{speed}}" bind:action="onAction" />
  </view>
  <playback-controls class="playback" language="{{language}}" speed="{{speed}}" loop="{{loop}}"
                     bind:playall="onPlayAll" bind:speedchange="onSpeedChange" bind:loopchange="onLoopChange" />
</view>
