<!-- CYLHUDViewController: insetGrouped, value cells (title left, value right); only the last row has a disclosure. -->
<view class="inset" id="hudDemo">
  <block wx:for="{{sections}}" wx:for-item="section" wx:key="index">
    <view class="section__header">{{section.header}}</view>
    <view class="section__body">
      <view wx:for="{{section.rows}}" wx:key="id" class="cell" hover-class="cell--pressed"
            data-id="{{item.id}}" bindtap="onRowTap" aria-role="button" aria-label="{{item.title}}">
        <view class="cell__text"><text class="cell__title">{{item.title}}</text></view>
        <text wx:if="{{item.value}}" class="cell__detail hud__value">{{item.value}}</text>
        <text wx:if="{{item.disclosure}}" class="cell__chevron">›</text>
      </view>
    </view>
  </block>
</view>

<cyl-placeholder-hud id="hud" generic:animation="cyl-lottie" bind:action="onHUDAction" />
