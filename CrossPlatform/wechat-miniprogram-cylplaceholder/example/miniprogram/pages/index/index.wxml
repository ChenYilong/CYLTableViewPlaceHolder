<view class="toolbar">
  <text class="toolbar__label">Language</text>
  <picker range="{{languageNames}}" value="{{languageIndex}}" bindchange="onLanguageChange">
    <view class="toolbar__value">{{languageNames[languageIndex]}} ›</view>
  </picker>
</view>
<view class="toolbar" hover-class="row--pressed" bindtap="onHUD">
  <text class="toolbar__label">CYLPlaceholderHUD</text>
  <text class="toolbar__value">›</text>
</view>
<view class="toolbar" hover-class="row--pressed" bindtap="onConfigurations">
  <text class="toolbar__label">Configuration files</text>
  <text class="toolbar__value">›</text>
</view>
<view wx:for="{{sections}}" wx:for-item="section" wx:key="category" class="section">
  <view class="section__header">{{section.category}}</view>
  <view class="section__body">
    <view wx:for="{{section.rows}}" wx:key="scenario" class="row" hover-class="row--pressed"
          bindtap="onOpen" data-scenario="{{item.scenario}}">
      <view class="row__text">
        <text class="row__name">{{item.name}}</text>
        <text class="row__sub">{{item.scenario}}{{item.shots ? '  · README ' + item.shots : ''}}</text>
      </view>
      <text class="row__chevron">›</text>
    </view>
  </view>
</view>
