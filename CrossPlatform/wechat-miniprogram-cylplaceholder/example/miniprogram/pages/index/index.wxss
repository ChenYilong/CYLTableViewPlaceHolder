.toolbar { display: flex; justify-content: space-between; align-items: center; margin: 12px 16px; padding: 12px 16px; background: #fff; border-radius: 10px; }
.toolbar__label { font-size: 15px; color: #333; }
.toolbar__value { font-size: 15px; color: #007aff; }
.section { margin: 0 16px 16px; }
.section__header { padding: 6px 4px; font-size: 13px; color: #8e8e93; text-transform: uppercase; }
.section__body { background: #fff; border-radius: 10px; overflow: hidden; }
.row { display: flex; align-items: center; padding: 12px 16px; border-bottom: 1px solid #f2f2f7; }
.row:last-child { border-bottom: none; }
.row--pressed { background: #e5e5ea; }
.row__text { flex: 1; display: flex; flex-direction: column; }
.row__name { font-size: 16px; color: #111; }
.row__sub { margin-top: 2px; font-size: 12px; color: #8e8e93; }
.row__chevron { font-size: 20px; color: #c7c7cc; }
