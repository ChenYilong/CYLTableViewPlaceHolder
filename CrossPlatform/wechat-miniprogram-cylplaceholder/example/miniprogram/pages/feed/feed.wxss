.page { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.content { flex: 1; min-height: 0; padding-bottom: calc(50px + env(safe-area-inset-bottom)); box-sizing: border-box; }
.bar__button--icon { font-size: 22px; }
.avatar { font-size: 20px; }
@media (prefers-color-scheme: dark) { .page { background: #000; } }
