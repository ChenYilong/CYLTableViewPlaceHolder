.page { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.content { flex: 1; min-height: 0; }
.bar__button--done { font-weight: 600; }
/* The iOS table has no separators. */
.row { padding: 12px 16px; font-size: 16px; line-height: 20px; }
.diy { position: relative; width: 100%; height: 100%; display: flex; flex-direction: row; align-items: center; justify-content: center; }
.diy__label { flex: 1; margin: 0 12px; text-align: center; font-size: 16px; font-weight: 700; color: #ff8000; }
.diy__switch { transform: scale(0.7); }
.diy__spinner { width: 18px; height: 18px; margin: 0 12px; border: 2px solid #c7c7cc; border-top-color: #636366; border-radius: 50%; visibility: hidden; }
.diy__spinner--on { visibility: visible; animation: diy-spin 0.8s linear infinite; }
@keyframes diy-spin { to { transform: rotate(360deg); } }
@media (prefers-color-scheme: dark) { .page { background: #000; } .row { color: #fff; } }
