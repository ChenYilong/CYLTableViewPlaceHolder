/* Metrics as cyl-refresh (MJRefresh): 54px header, 44px footer; the Cupertino header is 60px. */
:host { display: block; height: 100%; }
.er { position: relative; height: 100%; overflow: hidden; }
.er__scroll { position: relative; z-index: 0; height: 100%; }
/* Behind: the content scrolls above the pinned header; the page gives its rows a background. */
.er__scroll--behind { z-index: 2; }
.er__header { position: absolute; left: 0; right: 0; top: 0; z-index: 1; display: flex; flex-direction: row;
  align-items: center; justify-content: center; pointer-events: none; }
.er__header--behind { z-index: 1; }
.er__indicator { display: flex; align-items: center; justify-content: center; min-width: 30px; margin-right: 12px; }
.er__labels { display: flex; flex-direction: column; align-items: center; }
.er__state { font-size: 14px; font-weight: 600; line-height: 18px; color: #666; }
.er__time { font-size: 13px; line-height: 17px; color: #888; }
.er__arrow { display: inline-block; font-size: 24px; color: #8e8e93; transition: transform 0.2s; }
.er__arrow--up { transform: rotate(180deg); }
.er__spinner { width: 20px; height: 20px; border: 2px solid #c7c7cc; border-top-color: #636366; border-radius: 50%;
  animation: er-spin 0.8s linear infinite; }
/* UIActivityIndicatorView (medium): 12 gray ticks; spinning steps through them. */
.er__activity { position: relative; width: 20px; height: 20px; }
.er__activity--small { width: 20px; height: 20px; }
.er__activity--spinning { animation: er-spin 1s steps(12) infinite; }
.er__tick { position: absolute; left: 9px; top: 0; width: 2px; height: 6px; border-radius: 1px; background: #8e8e93;
  transform-origin: 1px 10px; }
@keyframes er-spin { to { transform: rotate(360deg); } }
.er__footer { display: flex; flex-direction: row; align-items: center; justify-content: center; }
.er__footer-text { margin-left: 8px; font-size: 14px; font-weight: 600; color: #666; }
@media (prefers-color-scheme: dark) {
  .er__state, .er__footer-text { color: #c7c7cc; }
  .er__time { color: #8e8e93; }
}
