<view class="er">
  <!-- Header over the refresher gap. Normal: it follows the content's top edge. Behind: pinned at the top, under
       the content (the scroll-view sits above it). Listener: nothing is drawn. -->
  <view wx:if="{{header !== 'none' && header !== 'listener' && (pull > 0 || headerState === 'Refreshing')}}"
        class="er__header {{behind ? 'er__header--behind' : ''}}"
        style="height: {{threshold}}px; {{behind ? '' : 'transform: translateY(' + (pull - threshold) + 'px);'}}"
        aria-role="progressbar" aria-label="{{texts.header}}">
    <block wx:if="{{header === 'cupertino'}}">
      <view class="er__activity {{headerState === 'Refreshing' ? 'er__activity--spinning' : ''}}"
            style="{{headerState === 'Refreshing' ? '' : 'opacity:' + percent + '; transform: rotate(' + (percent * 180) + 'deg);'}}">
        <view wx:for="{{ticks}}" wx:key="*this" class="er__tick" style="transform: rotate({{item * 30}}deg); opacity: {{0.25 + item * 0.0625}}" />
      </view>
    </block>
    <block wx:else>
      <view class="er__indicator">
        <view wx:if="{{headerState === 'Refreshing'}}" class="er__spinner" />
        <text wx:else class="er__arrow {{headerState === 'Pulling' ? 'er__arrow--up' : ''}}">↓</text>
      </view>
      <view class="er__labels">
        <text class="er__state">{{texts.header}}</text>
        <text class="er__time">{{texts.lastUpdated}}</text>
      </view>
    </block>
  </view>
  <scroll-view class="er__scroll {{behind ? 'er__scroll--behind' : ''}}" scroll-y enhanced="{{true}}" bounces="{{true}}"
               scroll-top="{{scrollTarget}}"
               refresher-enabled="{{header !== 'none'}}" refresher-threshold="{{threshold}}"
               refresher-default-style="none" refresher-background="transparent" refresher-triggered="{{triggered}}"
               bindrefresherpulling="onPulling" bindrefresherrefresh="onRefresherRefresh"
               bindrefresherrestore="onRefresherRestore" bindrefresherabort="onRefresherAbort"
               lower-threshold="20" bindscrolltolower="onScrollToLower" bindscroll="onScroll"
               bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
    <view class="er__content">
      <slot></slot>
    </view>
    <view wx:if="{{footer !== 'none' && !footerHidden}}" class="er__footer" style="height: {{footerSize}}px"
          aria-role="text" aria-label="{{texts.footerA11y}}">
      <view wx:if="{{footerState === 'Refreshing'}}" class="{{footer === 'cupertino' ? 'er__activity er__activity--small er__activity--spinning' : 'er__spinner'}}">
        <block wx:if="{{footer === 'cupertino'}}">
          <view wx:for="{{ticks}}" wx:key="*this" class="er__tick" style="transform: rotate({{item * 30}}deg); opacity: {{0.25 + item * 0.0625}}" />
        </block>
      </view>
      <text wx:if="{{texts.footer}}" class="er__footer-text">{{texts.footer}}</text>
    </view>
  </scroll-view>
</view>
