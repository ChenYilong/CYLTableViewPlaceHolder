.page { height: 100vh; display: flex; flex-direction: column; background: #f2f2f7; }
.content { flex: 1; min-height: 0; }
/* The list keeps the grouped table's background, so a colored .content only shows where the list is pulled away. */
.table { background: #f2f2f7; padding-bottom: 24px; min-height: 100%; box-sizing: border-box; }
/* grouped (not insetGrouped) table: full-width sections. */
.grouped__gap { height: 35px; }
.grouped__header { padding-top: 22px; }
.grouped__body { background: #fff; }
.slot { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.no-more { font-size: 14px; font-weight: 600; color: #666; }
@media (prefers-color-scheme: dark) {
  .page, .table { background: #000; }
  .grouped__body { background: #1c1c1e; }
  .no-more { color: #c7c7cc; }
}
