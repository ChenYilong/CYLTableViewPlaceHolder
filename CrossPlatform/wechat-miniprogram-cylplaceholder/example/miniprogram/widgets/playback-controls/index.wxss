.playback { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); }
.playback__row { display: flex; align-items: center; justify-content: space-between; margin-top: 8px; }
.playback__play { padding: 8px 20px; border-radius: 20px; background: #007aff; color: #fff; font-size: 16px; }
.playback__play--pressed { opacity: 0.6; }
.playback__loop { display: flex; align-items: center; }
.playback__label { font-size: 16px; color: #333; margin-right: 8px; }
.playback__slider { flex: 1; margin: 0 12px; }
.playback__value { min-width: 44px; text-align: right; font-size: 16px; color: #333; }
