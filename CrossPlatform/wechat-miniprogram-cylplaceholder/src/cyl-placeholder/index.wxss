/* The metrics follow android/placeholder (CYLPlaceholderView / CYLPlaceholderComponent): 16sp titles, 14sp hints,
   40dp buttons, the iOS system blue accent. */
:host { display: block; width: 100%; height: 100%; }
.cyl-placeholder { box-sizing: border-box; width: 100%; height: 100%; min-height: 360px; display: flex;
  align-items: center; justify-content: center; padding: 24px 32px; background: transparent; }
.cyl-placeholder__stack { display: flex; flex-direction: column; align-items: center; max-width: 320px; }
.cyl-placeholder__item { display: flex; flex-direction: column; align-items: center; }
.cyl-placeholder__icon-box { display: flex; flex-direction: column; align-items: center; }
.cyl-placeholder__icon--tinted { opacity: 0.45; }
.cyl-placeholder__title { margin-top: 12px; font-size: 16px; line-height: 22px; color: #333333; text-align: center; }
.cyl-placeholder__item > .cyl-placeholder__title { margin-top: 0; }
.cyl-placeholder__hint { font-size: 14px; line-height: 20px; color: #8e8e93; text-align: center; }
.cyl-placeholder__separator { display: flex; flex-direction: row; align-items: center; width: 200px; }
.cyl-placeholder__line { flex: 1; height: 1px; background: #d1d1d6; }
.cyl-placeholder__separator-text { margin: 0 10px; font-size: 13px; color: #8e8e93; }
.cyl-placeholder__button { min-width: 140px; height: 40px; line-height: 40px; padding: 0 20px; box-sizing: border-box;
  border-radius: 20px; font-size: 15px; text-align: center; }
.cyl-placeholder__button--Filled { background: #007aff; color: #ffffff; }
.cyl-placeholder__button--Outlined { border: 1px solid #007aff; color: #007aff; background: transparent; line-height: 38px; }
.cyl-placeholder__button--Capsule { background: #f2f2f7; color: #333333; border-radius: 999px; height: 36px; line-height: 36px; }
.cyl-placeholder__button--pressed { opacity: 0.6; }
.cyl-placeholder--compact { min-height: 0; padding: 0; }
