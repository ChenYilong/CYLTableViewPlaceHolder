<view class="cyl-refresh">
  <!-- Header: placed over the native refresher area, following the pull distance (pinned at the top when behind).
       It stays during the finish phase ("Refresh complete"). "listener" draws nothing. -->
  <view wx:if="{{header !== 'none' && header !== 'listener' && (pull > 0 || headerState === 'Refreshing' || finishing)}}"
        class="cyl-refresh__header {{behind ? 'cyl-refresh__header--behind' : ''}}"
        style="height: {{threshold}}px; {{behind ? '' : 'transform: translateY(' + (pull - threshold) + 'px);'}} {{automaticallyChangeAlpha && headerState !== 'Refreshing' && !finishing ? 'opacity:' + (pull / threshold) : ''}}"
        aria-role="progressbar" aria-label="{{texts.header}}">
    <!-- "diy": the page draws the header (slot "header", driven by the statechange / pull events). -->
    <slot wx:if="{{header === 'diy'}}" name="header"></slot>
    <!-- "cupertino": UIActivityIndicatorView's 12 ticks; they fade and turn in with the pull, then spin. -->
    <block wx:elif="{{header === 'cupertino'}}">
      <text wx:if="{{finishing}}" class="cyl-refresh__state" style="{{headerLabelStyle}}">{{texts.header}}</text>
      <view wx:else class="cyl-refresh__activity {{headerState === 'Refreshing' ? 'cyl-refresh__activity--spinning' : ''}}"
            style="{{headerState === 'Refreshing' ? '' : 'opacity:' + percent + '; transform: rotate(' + (percent * 180) + 'deg);'}}">
        <view wx:for="{{ticks}}" wx:key="*this" class="cyl-refresh__tick" style="transform: rotate({{item * 30}}deg); opacity: {{0.25 + item * 0.0625}}" />
      </view>
    </block>
    <block wx:else>
      <view class="cyl-refresh__indicator">
        <text wx:if="{{finishing}}" class="cyl-refresh__mark">{{finishing === 'Failed' ? '✕' : '✓'}}</text>
        <block wx:elif="{{headerIcon}}">
          <!-- The state's icon is a cyl-animated-item (CYLTabBarController's CYLAnimatedItem): the animation once its
               engine is ready, else the image, else the placeholder. The header is the accessibility element. -->
          <view wx:if="{{headerIcon.type !== 'unsupported'}}" class="cyl-refresh__icon-wrap" aria-hidden="true"
                style="width: {{headerIcon.width}}px; height: {{headerIcon.height}}px">
            <cyl-animated-item class="cyl-refresh__animated-icon" image="{{headerIcon.image}}" animation-url="{{headerIcon.animationUrl}}"
                               icon-size="{{headerIcon.width > headerIcon.height ? headerIcon.width : headerIcon.height}}" loop="{{iconLoop}}" speed="{{iconSpeed}}"
                               pag-wasm-path="{{pagWasmPath}}" rive-wasm-path="{{riveWasmPath}}"
                               accessibility-label="{{texts.header}}"
                               generic:cyl-lottie-view="animation" generic:cyl-pag-view="cyl-pag-view"
                               generic:cyl-rive-view="cyl-rive-view" generic:cyl-svga-view="cyl-svga-view" />
          </view>
          <view wx:else class="cyl-refresh__spinner" />
        </block>
        <block wx:elif="{{header === 'normal'}}">
          <view wx:if="{{headerState === 'Refreshing'}}" class="cyl-refresh__spinner" />
          <text wx:else class="cyl-refresh__arrow {{headerState === 'Pulling' ? 'cyl-refresh__arrow--up' : ''}}">↓</text>
        </block>
      </view>
      <view wx:if="{{!stateHidden || !lastUpdatedTimeHidden}}" class="cyl-refresh__labels">
        <text wx:if="{{!stateHidden}}" class="cyl-refresh__state" style="{{headerLabelStyle}}">{{texts.header}}</text>
        <text wx:if="{{!lastUpdatedTimeHidden}}" class="cyl-refresh__time" style="{{timeLabelStyle}}">{{texts.lastUpdated}}</text>
      </view>
    </block>
  </view>
  <scroll-view class="cyl-refresh__scroll {{behind ? 'cyl-refresh__scroll--behind' : ''}}" scroll-y enhanced="{{true}}" bounces="{{true}}"
               scroll-top="{{scrollTarget}}"
               refresher-enabled="{{header !== 'none'}}" refresher-threshold="{{threshold}}"
               refresher-default-style="none" refresher-background="transparent" refresher-triggered="{{triggered}}"
               bindrefresherpulling="onPulling" bindrefresherrefresh="onRefresherRefresh"
               bindrefresherrestore="onRefresherRestore" bindrefresherabort="onRefresherAbort"
               lower-threshold="40" bindscrolltolower="onScrollToLower" bindscroll="onScroll"
               bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
    <view class="cyl-refresh__content">
      <slot></slot>
    </view>
    <view wx:if="{{footer !== 'none' && !footerHidden && !placeholderShown}}" class="cyl-refresh__footer" style="height: {{footerSize}}px"
          bindtap="onFooterTap" aria-role="{{footer !== 'back' && footer !== 'diyBack' && footerState === 'Idle' ? 'button' : 'text'}}" aria-label="{{texts.footerA11y}}">
      <slot wx:if="{{footer === 'diy' || footer === 'diyBack'}}" name="footer"></slot>
      <block wx:else>
        <block wx:if="{{footerState === 'Refreshing' || footerIcon}}">
          <view wx:if="{{footerIcon && footerIcon.type !== 'unsupported'}}" class="cyl-refresh__icon-wrap" aria-hidden="true"
                style="width: {{footerIcon.width}}px; height: {{footerIcon.height}}px">
            <cyl-animated-item class="cyl-refresh__animated-icon" image="{{footerIcon.image}}" animation-url="{{footerIcon.animationUrl}}"
                               icon-size="{{footerIcon.width > footerIcon.height ? footerIcon.width : footerIcon.height}}" loop="{{iconLoop}}" speed="{{iconSpeed}}"
                               pag-wasm-path="{{pagWasmPath}}" rive-wasm-path="{{riveWasmPath}}"
                               accessibility-label="{{texts.footerA11y}}"
                               generic:cyl-lottie-view="animation" generic:cyl-pag-view="cyl-pag-view"
                               generic:cyl-rive-view="cyl-rive-view" generic:cyl-svga-view="cyl-svga-view" />
          </view>
          <view wx:elif="{{footer === 'cupertino'}}" class="cyl-refresh__activity cyl-refresh__activity--spinning">
            <view wx:for="{{ticks}}" wx:key="*this" class="cyl-refresh__tick" style="transform: rotate({{item * 30}}deg); opacity: {{0.25 + item * 0.0625}}" />
          </view>
          <view wx:else class="cyl-refresh__spinner" />
        </block>
        <text wx:elif="{{footer === 'back' && footerState !== 'NoMoreData' && !footerFinishing}}" class="cyl-refresh__arrow cyl-refresh__arrow--small {{footerState === 'Pulling' ? '' : 'cyl-refresh__arrow--up'}}">↓</text>
        <text wx:if="{{texts.footer}}" class="cyl-refresh__footer-text" style="{{footerLabelStyle}}">{{texts.footer}}</text>
      </block>
    </view>
  </scroll-view>
</view>
