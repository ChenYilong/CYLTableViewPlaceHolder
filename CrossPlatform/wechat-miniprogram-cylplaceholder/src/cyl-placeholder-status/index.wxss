/* CYLChatKit's colors: rgb(255, 199, 199) background; text #555555 (4.9:1, WCAG AA) instead of ChatKit's gray.
   Dark Mode: a dark red background with light pink text (needs "darkmode": true in app.json). */
.status { display: flex; flex-direction: row; align-items: center; box-sizing: border-box; padding: 0 12px;
  background: rgb(255, 199, 199); }
.status--pressed { opacity: 0.7; }
.status__icon { width: 22px; height: 22px; flex-shrink: 0; }
.status__text { margin-left: 8px; flex: 1; font-size: 14px; line-height: 18px; color: #555555;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@media (prefers-color-scheme: dark) {
  .status { background: rgb(110, 32, 36); }
  .status__text { color: #ffd1d1; }
}
