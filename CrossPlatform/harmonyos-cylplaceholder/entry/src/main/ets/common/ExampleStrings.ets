/** Language code -> the example texts in that language. */
export function ExampleStringTable(code: string): Record<string, string> {
  switch (code) {
    case 'zh-Hans':
      return ExampleStringsZhHans;
    case 'zh-Hant':
      return ExampleStringsZhHant;
    case 'ja':
      return ExampleStringsJa;
    case 'ko':
      return ExampleStringsKo;
    case 'ru':
      return ExampleStringsRu;
    case 'uk':
      return ExampleStringsUk;
    default:
      return ExampleStringsEn;
  }
}
