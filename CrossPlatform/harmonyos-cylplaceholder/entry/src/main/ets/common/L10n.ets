// The example's own texts and the language menu (CYLScenarioLocalization.swift / CYLScenarioLanguage.swift of the
// iOS example). Scenario texts come from the library (CYLPlaceholderLocalization); this file only holds the example's
// texts (ExampleStrings.ets, generated by scripts/import-example-strings.js) and the language switch.
import { preferences } from '@kit.ArkData';
import { common } from '@kit.AbilityKit';
import { CYLPlaceholderLocalization } from 'cylplaceholder';
import { ExampleStringTable } from './ExampleStrings';

/** One item of the language menu: native name and flag (CYLScenarioLanguage.swift). */
export class ExampleLanguage {
  code: string;
  name: string;
  flag: string;

  constructor(code: string, name: string, flag: string) {
    this.code = code;
    this.name = name;
    this.flag = flag;
  }
}

export const LANGUAGES: ExampleLanguage[] = [
  new ExampleLanguage('en', 'English', '🇺🇸'),
  new ExampleLanguage('zh-Hans', '简体中文', '🇨🇳'),
  new ExampleLanguage('zh-Hant', '繁體中文', '🇭🇰'),
  new ExampleLanguage('ja', '日本語', '🇯🇵'),
  new ExampleLanguage('ko', '한국어', '🇰🇷'),
  new ExampleLanguage('ru', 'Русский', '🇷🇺'),
  new ExampleLanguage('uk', 'Українська', '🇺🇦'),
];

/** AppStorage key bumped by setLanguage: the shell rebuilds the whole interface when it changes. */
export const EXAMPLE_GENERATION_KEY: string = 'CYLScenarioExampleGeneration';
const STORAGE_KEY: string = 'CYLScenarioLanguage';
const PREFERENCES_NAME: string = 'CYLScenarioExample';

let chosen: string = '';
let store: preferences.Preferences | null = null;

/** Reads the stored choice and applies it to the library (call once at launch). */
export function applyStoredLanguage(context: common.Context): void {
  try {
    store = preferences.getPreferencesSync(context, { name: PREFERENCES_NAME } as preferences.Options);
    chosen = store.getSync(STORAGE_KEY, '') as string;
  } catch (e) {
    chosen = '';
  }
  CYLPlaceholderLocalization.language = chosen.length > 0 ? chosen : null;
}

/** The language the user chose, or '' to follow the system. */
export function chosenLanguage(): string {
  return chosen;
}

/** The language in use: the chosen one, else the system's (resolved to a supported language). */
export function effectiveLanguage(): string {
  return chosen.length > 0 ? chosen : CYLPlaceholderLocalization.effectiveLanguage;
}

/**
 * Chooses a language ('' follows the system) and rebuilds the whole interface, as the iOS example's
 * cyl_setRootViewControllerProvider does: back to the first tab.
 */
export function setLanguage(code: string): void {
  chosen = code;
  try {
    if (store !== null) {
      store.putSync(STORAGE_KEY, code);
      store.flush();
    }
  } catch (e) {
  }
  CYLPlaceholderLocalization.language = code.length > 0 ? code : null;
  const generation = AppStorage.get<number>(EXAMPLE_GENERATION_KEY) ?? 0;
  AppStorage.setOrCreate<number>(EXAMPLE_GENERATION_KEY, generation + 1);
}

/**
 * CYLScenarioLocalizedString: the example text for a key in the effective language, else English, else the key.
 * Extra arguments fill %@, %ld, %d and %1$@-style placeholders in order.
 */
export function t(key: string, ...args: Object[]): string {
  const table = ExampleStringTable(effectiveLanguage());
  const english = ExampleStringTable('en');
  let text: string = table[key] !== undefined ? table[key] : (english[key] !== undefined ? english[key] : key);
  let next = 0;
  text = text.replace(/%(\d+\$)?(@|ld|lu|d|s|\.\df|f)/g, (match: string, position: string | undefined,
    kind: string) => {
    const index = position !== undefined && position.length > 0 ? parseInt(position, 10) - 1 : next++;
    if (index >= args.length) {
      return '';
    }
    const value = args[index];
    if (kind.length > 1 && kind.endsWith('f')) {
      return Number(value).toFixed(Number(kind.charAt(1)));
    }
    return String(value);
  });
  return text;
}

/** cyl_showFeedback: a message that closes itself after 1 s. */
export function showFeedback(context: UIContext, message: string): void {
  context.getPromptAction().showToast({ message: message, duration: 1000 });
}
