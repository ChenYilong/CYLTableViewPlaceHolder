{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "5.1.0(18)",
        "targetSdkVersion": "6.0.1(21)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" },
      { "name": "emulatorTest" }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] },
        { "name": "emulator", "applyToProducts": ["default"] }
      ]
    },
    {
      "name": "cylplaceholder",
      "srcPath": "./cylplaceholder"
    },
    {
      "name": "cylanimateditem",
      "srcPath": "./cylanimateditem"
    },
    {
      "name": "cylanimateditem_lottie",
      "srcPath": "./cylanimateditem_lottie"
    },
    {
      "name": "cylanimateditem_pag",
      "srcPath": "./cylanimateditem_pag"
    },
    {
      "name": "cylanimateditem_rive",
      "srcPath": "./cylanimateditem_rive"
    },
    {
      "name": "cyldeallocblockexecutor",
      "srcPath": "./cyldeallocblockexecutor"
    },
    {
      "name": "classifymenu",
      "srcPath": "./classifymenu"
    },
    {
      "name": "cylanimateditemrive",
      "srcPath": "./cylanimateditemrive"
    }
  ]
}
