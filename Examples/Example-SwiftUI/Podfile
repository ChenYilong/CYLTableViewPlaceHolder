platform :ios, '15.0'
ENV['SWIFT_VERSION'] = '5'
project 'Example-SwiftUI.xcodeproj'
use_frameworks!

target 'ExampleSwiftUI' do
  pod 'CYLTableViewPlaceHolder', :path => '../..'
  # CYLTableViewPlaceHolder's Core depends on the CYLAnimatedItem pod (CYLPlaceholderView is a CYLAnimatedItemView), which
  # lives in the CYLTabBarController repository and is not on the trunk yet. Always that repository's newest commit on
  # any branch (instructions.md, "Depending on CYLTabBarController"); scripts/resolve-cyltabbarcontroller-commit.sh
  # rewrites the commit before every build.
  pod 'CYLAnimatedItem', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => '31d6418f83e6f4ab455f338b32621240d1a98319'
  # The newest commit splits CYLBadge and CYLUtils out as pods of their own (CYLAnimatedItem/Core depends on CYLBadge, which depends on
  # CYLUtils, which needs CYLDeallocBlockExecutor ~> 1.4); none of the three is on the CocoaPods trunk, so each is pinned here.
  pod 'CYLBadge', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => '31d6418f83e6f4ab455f338b32621240d1a98319'
  pod 'CYLUtils', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => '31d6418f83e6f4ab455f338b32621240d1a98319'
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '4276a6dab5a428ccc3a5f3f347eab991881fb97c'
  # CYLRefresh is the only refresh library; no other refresh pod (instructions.md, "One refresh library: CYLRefresh").
  pod 'SwiftUIIntrospect', '26.0.0'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
