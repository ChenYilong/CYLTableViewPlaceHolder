platform :ios, '15.0'
ENV['SWIFT_VERSION'] = '5'
project 'Example-objc-01.xcodeproj'
use_frameworks!

target 'ExampleObjC01' do
  pod 'CYLTableViewPlaceHolder', :path => '../..'
  # The original library CYLRefresh is adapted from, always at its latest version (scripts/resolve-mjrefresh-version.sh
  # sets it before every build; instructions.md, "Depending on MJRefresh in the examples").
  pod 'MJRefresh', '3.7.9'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
