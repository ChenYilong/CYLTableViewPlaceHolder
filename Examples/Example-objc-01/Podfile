platform :ios, '15.0'
ENV['SWIFT_VERSION'] = '5'
project 'Example-objc-01.xcodeproj'
use_frameworks!

target 'ExampleObjC01' do
  pod 'CYLTableViewPlaceHolder', :path => '../..'
  # CYLTableViewPlaceHolder's Core depends on CYLTabBarController's CYLAnimatedItem subspec (CYLPlaceholderView is a
  # CYLAnimatedItemView). Always CYLTabBarController's newest commit on any branch (instructions.md, "Depending on
  # CYLTabBarController"); scripts/resolve-cyltabbarcontroller-commit.sh rewrites the commit before every build.
  pod 'CYLTabBarController', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => '7b6fd11d886d89c2c1de2ccca341403cb3a57267', :subspecs => ['CYLAnimatedItem']
  # CYLRefresh is the only refresh library; no other refresh pod (instructions.md, "One refresh library: CYLRefresh").
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
