platform :ios, '15.0'
ENV['SWIFT_VERSION'] = '5'
project 'Example-Scenarios.xcodeproj'
use_frameworks!

target 'ExampleScenarios' do
  # Every animation engine, so the demo can play the bundled Lottie, PAG, Rive and GIF placeholders.
  pod 'CYLTableViewPlaceHolder', :path => '../..', :subspecs => ['Core', 'LottieSwift', 'PAG', 'Rive', 'GIF']
  # The original library CYLRefresh is adapted from, always at its latest version (scripts/resolve-mjrefresh-version.sh
  # sets it before every build; instructions.md, "Depending on MJRefresh in the examples").
  pod 'MJRefresh', '3.7.9'
  # The tab bar with the plus button and the language rebuild (`cyl_setRootViewControllerProvider`), as in
  # CYLTabBarController's Objective-C demo. Always its newest commit on any branch (instructions.md, "Depending on
  # CYLTabBarController"); scripts/resolve-cyltabbarcontroller-commit.sh rewrites the commit before every build.
  pod 'CYLTabBarController', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => 'bbe13f89f58627e25d34d454357f7456d9e2714f'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
