platform :ios, '15.0'
ENV['SWIFT_VERSION'] = '5'
project 'Example-Scenarios.xcodeproj'
use_frameworks!

target 'ExampleScenarios' do
  # Core shows static images only; the animation subspecs add the engine and one animator each
  # (CYLAnimatedItem/<Type>), so this demo plays the bundled Lottie, PAG, Rive and GIF animations.
  pod 'CYLTableViewPlaceHolder', :path => '../..', :subspecs => ['Core', 'LottieSwift', 'PAG', 'Rive', 'SVGA', 'GIF']
  # CYLRefresh is the only refresh library; no other refresh pod (instructions.md, "One refresh library: CYLRefresh").
  # The tab bar with the plus button and the language rebuild (`cyl_setRootViewControllerProvider`), as in
  # CYLTabBarController's Objective-C demo. Always its newest commit on any branch (instructions.md, "Depending on
  # CYLTabBarController"); scripts/resolve-cyltabbarcontroller-commit.sh rewrites the commit before every build.
  # CYLTabBarController depends on CYLAnimatedItem at the same version: both from the same commit.
  pod 'CYLAnimatedItem', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => 'c90d4e98598802d7fb8ba53ebe276febecb5bc5b'
  pod 'CYLTabBarController', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => 'c90d4e98598802d7fb8ba53ebe276febecb5bc5b'
  # The newest commit splits CYLBadge and CYLUtils out as pods of their own (CYLAnimatedItem/Core depends on CYLBadge, which depends on
  # CYLUtils, which needs CYLDeallocBlockExecutor ~> 1.4); none of the three is on the CocoaPods trunk, so each is pinned here.
  pod 'CYLBadge', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => 'c90d4e98598802d7fb8ba53ebe276febecb5bc5b'
  pod 'CYLUtils', :git => 'https://github.com/ChenYilong/CYLTabBarController.git', :commit => 'c90d4e98598802d7fb8ba53ebe276febecb5bc5b'
  # CYLTabBarController's core and badge need CYLDeallocBlockExecutor ~> 1.4, which is not on the CocoaPods trunk yet (trunk has
  # 1.3.0); the same commit as CollectionViewClassifyMenu's Podfile.
  pod 'CYLDeallocBlockExecutor', :git => 'https://github.com/ChenYilong/CYLDeallocBlockExecutor.git', :commit => '4276a6dab5a428ccc3a5f3f347eab991881fb97c'
  # The tag list of the sectioned index screens (docs/instructions/examples.md, "Sectioned lists in demos use the tag
  # list"): examples only, never the core library. By commit, as CYLTabBarController: the tip of CollectionViewClassifyMenu's
  # feat/tag-long-press-action, the first commit with the iOS long-press callout and titleMaxLines (360ce0bf has Harmony only).
  pod 'CollectionViewClassifyMenu', :git => 'https://github.com/ChenYilong/CollectionViewClassifyMenu.git', :commit => '00b40e8dd222aeffab3002883175431c05e5dd1a'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "15.0"
    end
  end
end
